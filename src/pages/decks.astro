---
import Base from '../layouts/Base.astro';
import decks from '../data/decks.json';

type Deck = (typeof decks)[number];

const groups = [
  {
    key: 'professional',
    title: 'The professional set',
    note: 'One ladder, four jobs: think, judge, govern, adopt. Start with Thinking.',
  },
  {
    key: 'course',
    title: 'Course decks',
    note: 'Companions to the courses, de-vendored so they survive the next product rename.',
  },
  {
    key: 'book',
    title: 'Book & app decks',
    note: 'Companion objects to the books and to Winnow — ideas you can hold, sort and hand out.',
  },
] as const;

const byGroup = (key: string) =>
  (decks as Deck[])
    .filter((d) => d.group === key)
    .sort((a, b) => (('step' in a ? a.step : 0) as number) - (('step' in b ? b.step : 0) as number));
---

<Base
  title="Decks · borck.consulting"
  description={`${decks.length} free, printable card decks for thinking, judging, adopting and governing AI. A deck, a one-page guide and a desk card for each. No sign-up, no email.`}
  pageClass="page-wide"
>
  <div class="hero">
    <p class="hero-eyebrow">Decks</p>
    <h1 class="hero-title">Free card decks for the work AI changes.</h1>
    <p class="hero-sub">
      {decks.length} printable decks distilled from books, courses and frameworks. Each is a
      stack of cards you cut out and use, with a one-page guide and a desk card.
      Use one at your desk or run a sixty-minute session with a team.
    </p>
    <p class="hero-sub" style="margin-top: 0;">
      <strong>No sign-up, no email, no account. Print, use, keep.</strong>
    </p>
  </div>

  {groups.map((group) => {
    const items = byGroup(group.key);
    if (items.length === 0) return null;
    return (
      <div class="section">
        <div class="section-header">
          <span class="section-title">{group.title}</span>
          <span class="section-count">{items.length} decks</span>
        </div>
        <p class="section-note">{group.note}</p>

        <div class={`deck-grid deck-grid--${group.key}`}>
          {items.map((d) => (
            <article class="deck-card">
              <a class="deck-cover" href={d.base} aria-hidden="true" tabindex="-1">
                <img src={d.base + d.cover} alt="" loading="lazy" decoding="async" />
              </a>
              <div class="deck-body">
                <div class="deck-eyebrow">
                  <span>
                    {'step' in d && d.step ? `Step ${String(d.step).padStart(2, '0')}` : 'Deck'}
                  </span>
                  <span>{d.cards} cards</span>
                </div>
                <h3 class="deck-title"><a href={d.base}>{d.title}</a></h3>
                <p class="deck-tagline">{d.tagline}</p>
                <p class="deck-blurb">{d.blurb}</p>
                <div class="deck-links">
                  <a class="open" href={d.base}>Open &rarr;</a>
                  <a href={d.base + d.print}>Print</a>
                  <a href={d.base + d.guide}>Guide</a>
                  <a href={d.base + d.desk}>Desk card</a>
                  <a href={d.repo}>Source</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    );
  })}

  <div class="section">
    <div class="section-header">
      <span class="section-title">How a deck works</span>
    </div>
    <div class="tier-grid">
      <div class="tier-card">
        <div class="tier-card-eyebrow">The deck</div>
        <div class="tier-card-title">Treats</div>
        <p class="tier-card-desc">
          Why it goes wrong, the move, the line to remember. Print, cut, pull one when
          it comes up.
        </p>
      </div>
      <div class="tier-card">
        <div class="tier-card-eyebrow">The one-page guide</div>
        <div class="tier-card-title">Diagnoses</div>
        <p class="tier-card-desc">
          The "not yet"s name your weakest section, so you know which cards to pull
          first.
        </p>
      </div>
      <div class="tier-card">
        <div class="tier-card-eyebrow">The desk card</div>
        <div class="tier-card-title">Stays</div>
        <p class="tier-card-desc">
          Every card, every line, on one A4 pin-up for the wall, after the deck has
          done its work.
        </p>
      </div>
    </div>
  </div>

  <p class="scope-line">
    A licence line, not a funnel. Print as many as you like, use them in your team
    meetings, don't resell them. Deck content is CC BY-NC-SA 4.0; the print layouts
    and code are MIT. The Markdown and print source for every deck is open on
    <a href="https://github.com/michael-borck">GitHub</a>.
  </p>
</Base>

<style>
  .section-count {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gray-2);
  }

  .section-note {
    font-size: 0.9rem;
    color: var(--gray-1);
    line-height: 1.6;
    margin: -0.5rem 0 1.5rem;
    max-width: 640px;
  }

  .deck-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1rem;
  }

  .deck-grid--professional {
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }

  .deck-card {
    background: var(--panel);
    border: 1px solid var(--gray-3);
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s;
  }

  .deck-card:hover {
    border-color: var(--accent);
  }

  .deck-cover {
    display: block;
    background: var(--gray-4);
    aspect-ratio: 3 / 4;
    padding: 0.9rem;
    text-decoration: none;
  }

  .deck-cover img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    border-radius: 4px;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.14);
  }

  .deck-body {
    padding: 0.95rem 1.05rem 1.1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .deck-eyebrow {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }

  .deck-eyebrow span:last-child {
    color: var(--gray-2);
  }

  .deck-title {
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.25;
    margin-bottom: 0.35rem;
  }

  .deck-title a {
    color: var(--text);
    text-decoration: none;
  }

  .deck-title a:hover {
    color: var(--accent);
  }

  .deck-tagline {
    font-size: 0.82rem;
    font-style: italic;
    color: var(--gray-1);
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }

  .deck-blurb {
    font-size: 0.8rem;
    color: var(--gray-2);
    line-height: 1.5;
    margin-bottom: 0.9rem;
    flex: 1;
  }

  .deck-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    font-size: 0.75rem;
  }

  .deck-links a {
    color: var(--accent);
    text-decoration: none;
  }

  .deck-links a:hover {
    color: var(--accent-high);
    text-decoration: underline;
  }

  .deck-links .open {
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .deck-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .deck-cover {
      padding: 0.6rem;
    }
    .deck-body {
      padding: 0.8rem 0.85rem 0.9rem;
    }
  }

  @media (max-width: 420px) {
    .deck-grid {
      grid-template-columns: 1fr;
    }
  }
</style>