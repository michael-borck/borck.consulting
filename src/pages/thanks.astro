---
import Base from '../layouts/Base.astro';
---
<Base title="Message sent · borck.consulting" description="Your message has been sent. I reply within two business days.">

  <div class="hero">
    <p class="hero-eyebrow">Message sent</p>
    <h1 class="hero-title">Thank you.</h1>
    <p class="hero-sub">
      Your message has been sent. I reply within two business days.
    </p>
  </div>

  <div class="contact-block">
    <h2 class="contact-block-title">What happens next</h2>
    <ol class="contact-list">
      <li>I read the message and reply within two business days.</li>
      <li>If it looks like a fit, we book a free 30-minute call.</li>
      <li>If it does not, I will say so and point you elsewhere.</li>
    </ol>
    <p style="margin-top: 1.5rem;">
      <a href="/" class="btn btn-secondary">Back to the practice</a>
    </p>
  </div>

</Base>
