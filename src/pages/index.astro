---
import Base from '../layouts/Base.astro';
import { getPublishedEssays } from '../lib/essays';

const allEssays = await getPublishedEssays();
const latestEssay = allEssays[0];

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="borck.consulting · AI literacy, governance, and data sovereignty for regulated Australian small businesses">

  <div class="hero">
    <p class="hero-eyebrow">A private practice · Michael Borck</p>
    <h1 class="hero-title">
      AI literacy, governance, and data sovereignty for regulated Australian small businesses.
    </h1>
    <p class="hero-sub">
      <strong>AI can do the work. Your firm is paid for the judgment.</strong>
      Most AI rollouts fail at the team level. This practice helps law firms, medical practices,
      accounting firms, and financial advisory practices adopt AI as a collaborator, with
      governance and data sovereignty by design.
    </p>
    <p class="hero-credibility">
      <strong>Michael Borck</strong> · Lecturer at Curtin University, teaching AI and cyber security ·
      author of <em>Conversation, Not Delegation</em> and <em>The Human Edge</em> ·
      creator of the framework, adopted onto the reading list at Kaplan Business School ·
      runs a personal local-AI research lab on his own hardware.
    </p>
    <a href="/contact" class="btn">Book a Diagnostic</a>
  </div>

  <div class="section">
    <div class="section-header">
      <span class="section-title">The Practice</span>
    </div>
    <div class="tier-grid">
      <div class="tier-card">
        <div class="tier-card-eyebrow">Tier 1 · Foundation</div>
        <div class="tier-card-title">Literacy &amp; collaboration</div>
        <p class="tier-card-desc">
          Workshops and programs grounded in the Conversation-not-Delegation framework.
          The substantive change comes before any policy is written.
        </p>
      </div>
      <div class="tier-card">
        <div class="tier-card-eyebrow">Tier 2 · Governance</div>
        <div class="tier-card-title">Audit &amp; policy</div>
        <p class="tier-card-desc">
          AI use-policy development and a governance audit specific to how a regulated
          firm actually operates.
        </p>
      </div>
      <div class="tier-card">
        <div class="tier-card-eyebrow">Tier 3 · Sovereignty</div>
        <div class="tier-card-title">Data sovereignty &amp; local AI</div>
        <p class="tier-card-desc">
          Advisory and time-boxed local-AI deployment for firms whose clients or
          regulators expect that sensitive material does not leave the building.
        </p>
      </div>
    </div>
  </div>

  <p class="scope-line">
    The practice does not undertake enterprise tenders, hourly billing, staff
    augmentation, or open-ended implementation work. Engagements are fixed-scope
    and fixed-price.
  </p>

  <div class="section">
    <div class="section-header">
      <span class="section-title">The Human Edge</span>
    </div>
    <p class="hero-sub" style="max-width: none;">
      The same argument runs through the practice and the book
      <em>The Human Edge</em>. Michael also designs and delivers the Curtin Executive
      Education masterclass of the same name in his academic role. Curtin University does
      not endorse or sponsor this practice.
    </p>
    <p style="font-size: 0.9rem; color: var(--gray-1); line-height: 1.7; max-width: 680px; margin-bottom: 1rem;">
      Passive delegation accepts the output without framing the problem, checking the claim,
      or making the decision. Active use puts the effort where it builds capability. The tool
      is the same in both cases; the use is what differs.
    </p>
    <p style="font-size: 0.9rem; color: var(--gray-1); line-height: 1.7; max-width: 680px; margin-bottom: 0.75rem;">
      Five patterns of active use matter:
    </p>
    <div class="pattern-table-wrap">
      <table class="pattern-table">
        <thead>
          <tr><th>Pattern</th><th>What it looks like</th><th>What it strengthens</th></tr>
        </thead>
        <tbody>
          <tr><td>Build</td><td>Do a rough pass first, then compare it with AI.</td><td>Retrieval, generation and calibration</td></tr>
          <tr><td>Explore</td><td>Generate alternatives, challenge assumptions and surface what you missed.</td><td>Flexibility and breadth</td></tr>
          <tr><td>Collaborate</td><td>Use AI to widen who can take part, and keep the person on the other side.</td><td>Perspective-taking and coordination</td></tr>
          <tr><td>Converse</td><td>Prepare better questions and keep the human conversation.</td><td>Listening and relational judgement</td></tr>
          <tr><td>Judge</td><td>Keep the decision, accountability and final check with a person.</td><td>Consequence reasoning and ownership</td></tr>
        </tbody>
      </table>
    </div>
    <p style="font-size: 0.9rem; color: var(--gray-1); line-height: 1.7; max-width: 680px; margin-bottom: 1.5rem;">
      The mechanism is the right amount of challenge, with feedback and a way to test whether
      the capability transfers. Struggle for its own sake is not the goal. The patterns overlap,
      and a workflow that removes all five may be faster and still leave the firm less capable.
      The saved time has to go somewhere useful.
    </p>
    <a href="https://michael-borck.github.io/the-human-edge-using/" class="btn btn-secondary">Read The Human Edge</a>
  </div>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Evidence</span>
    </div>
    <p class="hero-sub" style="max-width: none;">
      The method is public. The client work is private. Inspect the
      <a href="/evidence">evidence</a>, the <a href="https://locolabo.org">local-AI lab</a>,
      or the <a href="https://notes.borck.consulting">field notes</a>.
    </p>
  </div>

  {latestEssay && (
    <div class="section">
      <div class="section-header">
        <span class="section-title">Latest Writing</span>
      </div>
      <a href={`/writing/${latestEssay.id.replace(/\.md$/, '')}`} class="latest-essay">
        <div class="latest-essay-eyebrow">{formatDate(latestEssay.data.publishDate)}</div>
        <div class="latest-essay-title">{latestEssay.data.title}</div>
        <div class="latest-essay-desc">{latestEssay.data.description}</div>
      </a>
    </div>
  )}

</Base>
