---
import Base from '../layouts/Base.astro';
import { getPublishedEssays } from '../lib/essays';

const allEssays = await getPublishedEssays();
const latestEssay = allEssays[0];

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="borck.consulting · AI literacy, governance, and data sovereignty for regulated Australian small businesses">

  <div class="hero">
    <p class="hero-eyebrow">A private practice · Michael Borck</p>
    <h1 class="hero-title">
      AI literacy, governance, and data sovereignty for regulated Australian small businesses.
    </h1>
    <p class="hero-sub">
      <strong>AI can do the work. Your firm is paid for the judgment.</strong>
      Most AI rollouts fail at the team level. This practice helps law firms, medical practices,
      accounting firms, and financial advisory practices adopt AI as a collaborator, with
      governance and data sovereignty by design.
    </p>
    <p class="hero-credibility">
      <strong>Michael Borck</strong> · Lecturer at Curtin University, teaching AI and cyber security ·
      author of the <em>Conversation not Delegation</em> book series · creator of the framework,
      adopted onto the reading list at Kaplan Business School ·
      runs a personal local-AI research lab on his own hardware.
    </p>
    <a href="/contact" class="btn">Book a Diagnostic</a>
  </div>

  <div class="section">
    <div class="section-header">
      <span class="section-title">The Practice</span>
    </div>
    <div class="tier-grid">
      <div class="tier-card">
        <div class="tier-card-eyebrow">Tier 1 · Foundation</div>
        <div class="tier-card-title">Literacy &amp; collaboration</div>
        <p class="tier-card-desc">
          Workshops and programs grounded in the Conversation-not-Delegation framework.
          The substantive change comes before any policy is written.
        </p>
      </div>
      <div class="tier-card">
        <div class="tier-card-eyebrow">Tier 2 · Governance</div>
        <div class="tier-card-title">Audit &amp; policy</div>
        <p class="tier-card-desc">
          AI use-policy development and a governance audit specific to how a regulated
          firm actually operates.
        </p>
      </div>
      <div class="tier-card">
        <div class="tier-card-eyebrow">Tier 3 · Sovereignty</div>
        <div class="tier-card-title">Data sovereignty &amp; local AI</div>
        <p class="tier-card-desc">
          Advisory and time-boxed local-AI deployment for firms whose clients or
          regulators expect that sensitive material does not leave the building.
        </p>
      </div>
    </div>
  </div>

  <p class="scope-line">
    The practice does not undertake enterprise tenders, hourly billing, staff
    augmentation, or open-ended implementation work. Engagements are fixed-scope
    and fixed-price.
  </p>

  <div class="section">
    <div class="section-header">
      <span class="section-title">The Human Edge</span>
    </div>
    <p class="hero-sub" style="max-width: none;">
      The same argument runs through the practice, the forthcoming book
      <em>The Human Edge</em>, and the Curtin Executive Education masterclass.
    </p>
    <p style="font-size: 0.9rem; color: var(--gray-1); line-height: 1.7; max-width: 600px; margin-bottom: 1.5rem;">
      The masterclass runs the same four steps the practice uses: Judge, Brief, Check, Deliver.
      It is for professionals who need to decide what AI should do, what a person must still
      own, and how to explain that choice to a client or a regulator.
    </p>
    <a href="https://michael-borck.github.io/the-human-edge/" class="btn btn-secondary">See the masterclass</a>
  </div>

  <div class="section">
    <div class="section-header">
      <span class="section-title">Evidence</span>
    </div>
    <p class="hero-sub" style="max-width: none;">
      The method is public. The client work is private. Inspect the
      <a href="/evidence">evidence</a>, the <a href="https://locolabo.org">local-AI lab</a>,
      or the <a href="https://notes.borck.consulting">field notes</a>.
    </p>
  </div>

  {latestEssay && (
    <div class="section">
      <div class="section-header">
        <span class="section-title">Latest Writing</span>
      </div>
      <a href={`/writing/${latestEssay.id.replace(/\.md$/, '')}`} class="latest-essay">
        <div class="latest-essay-eyebrow">{formatDate(latestEssay.data.publishDate)}</div>
        <div class="latest-essay-title">{latestEssay.data.title}</div>
        <div class="latest-essay-desc">{latestEssay.data.description}</div>
      </a>
    </div>
  )}

</Base>
