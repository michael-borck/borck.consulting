---
import Base from '../layouts/Base.astro';
---
<Base title="Contact · borck.consulting" description="Send a short message about an AI Readiness Diagnostic for your firm.">

  <div class="hero">
    <p class="hero-eyebrow">Contact</p>
    <h1 class="hero-title">Start with a short message.</h1>
    <p class="hero-sub">
      A few sentences is enough. Inquiries are answered within two business days.
      If a Diagnostic fits, we will arrange a 30-minute call.
    </p>
  </div>

  <div class="contact-block">
    <h2 class="contact-block-title">Send a message</h2>
    <p class="contact-block-desc">
      The firm, the AI problem, and any deadline or regulator pressure.
    </p>
    <form class="contact-form" method="POST" action="https://forms.borck.consulting/contact">
      <div>
        <label for="name">Your name</label>
        <input type="text" id="name" name="name" required maxlength="200" />
      </div>
      <div>
        <label for="firm">Firm</label>
        <input type="text" id="firm" name="firm" maxlength="200" />
      </div>
      <div>
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required maxlength="320" />
      </div>
      <div>
        <label for="situation">What is the situation?</label>
        <textarea
          id="situation"
          name="situation"
          rows="5"
          maxlength="5000"
          placeholder="The firm, the AI problem, and what you have already tried."
        ></textarea>
      </div>
      <div style="position: absolute; left: -9999px;" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>
      <button type="submit" class="btn" style="align-self: flex-start; cursor: pointer; font-family: var(--font);">
        Send
      </button>
    </form>
    <p style="margin-top: 1rem; font-size: 0.85rem; color: var(--gray-2);">
      Or email <a href="mailto:michael@borck.dev">michael@borck.dev</a>.
    </p>
    <p style="margin-top: 0.75rem; font-size: 0.8rem; color: var(--gray-2);">
      Please do not send confidential client material through this form. We can arrange
      a secure channel before any engagement.
    </p>
  </div>

  <div class="contact-block">
    <h2 class="contact-block-title">What happens next</h2>
    <ol class="contact-list">
      <li>I reply within two business days.</li>
      <li>If it looks like a fit, we book a free 30-minute call.</li>
      <li>If it does not, I will say so and point you elsewhere.</li>
    </ol>
  </div>

</Base>
