---
import Base from '../layouts/Base.astro';
---
<Base title="Contact · borck.consulting" description="Email Michael Borck about an AI Readiness Diagnostic for your firm.">

  <div class="hero">
    <p class="hero-eyebrow">Contact</p>
    <h1 class="hero-title">Start with an email.</h1>
    <p class="hero-sub">
      Inquiries are answered within two business days. Tell me the firm, the problem,
      and the timeline. If a Diagnostic fits, we will arrange a 30-minute call.
    </p>
  </div>

  <div class="contact-block">
    <h2 class="contact-block-title">Email</h2>
    <p class="contact-block-desc">
      The fastest route is a short email with enough context to make the first reply useful.
    </p>
    <p>
      <a href="mailto:michael@borck.dev" style="font-family: var(--mono); font-weight: 600;">
        michael@borck.dev
      </a>
    </p>
    <p style="margin-top: 1.25rem;">
      <a href="mailto:michael@borck.dev?subject=AI%20Readiness%20Diagnostic" class="btn">Email Michael</a>
    </p>
  </div>

  <div class="contact-block">
    <h2 class="contact-block-title">What to include</h2>
    <ul class="contact-list">
      <li>The firm and the kind of work it does.</li>
      <li>The AI problem or decision in front of you.</li>
      <li>What you have already tried, if anything.</li>
      <li>Any deadline or regulator pressure.</li>
    </ul>
  </div>

  <div class="contact-block">
    <h2 class="contact-block-title">What happens next</h2>
    <ol class="contact-list">
      <li>I reply within two business days.</li>
      <li>If it looks like a fit, we book a free 30-minute call.</li>
      <li>If it does not, I will say so and point you elsewhere.</li>
    </ol>
  </div>

</Base>
